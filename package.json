{
  "name": "@supersuit/artifacts",
  "version": "0.2.0",
  "description": "Publish markdown as branded, read-aloud pages from a Next.js app: the artifacts store, the route factory, the read-along reader, brand packs, password and confidential pages, and share cards.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupersuitUp/artifacts.git"
  },
  "homepage": "https://github.com/SupersuitUp/artifacts#readme",
  "bugs": "https://github.com/SupersuitUp/artifacts/issues",
  "keywords": [
    "nextjs",
    "markdown",
    "publishing",
    "firestore",
    "read-aloud",
    "og-image"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./artifacts": {
      "types": "./lib/artifacts/index.d.ts",
      "default": "./lib/artifacts/index.js"
    },
    "./routes": {
      "types": "./lib/routes/artifacts.d.ts",
      "default": "./lib/routes/artifacts.js"
    },
    "./brand": {
      "types": "./lib/brand/index.d.ts",
      "default": "./lib/brand/index.js"
    },
    "./reader": {
      "types": "./lib/reader/artifact-reader.d.ts",
      "default": "./lib/reader/artifact-reader.js"
    },
    "./gate": {
      "types": "./lib/gate.d.ts",
      "default": "./lib/gate.js"
    },
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "fonts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:packed": "node scripts/check-packed.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@google-cloud/storage": ">=7",
    "firebase-admin": ">=13",
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@google-cloud/storage": {
      "optional": true
    }
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.1.2",
    "firebase-admin": "^13.7.0",
    "jsdom": "^26",
    "next": "^16.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
